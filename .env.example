# Copy to .env and adjust. docker-compose reads this automatically.

# ---- Ollama (runs on the HOST, not in a container) --------------------------
# macOS/Windows: leave as is. Linux: host-gateway is wired up in compose.
OLLAMA_HOST=http://host.docker.internal:11434
LLM_MODEL=mistral:latest

# ---- Embeddings -------------------------------------------------------------
# multilingual-e5-large  1024 dims, ~2.2 GB, best German quality
# multilingual-e5-base    768 dims, ~1.1 GB
# multilingual-e5-small   384 dims, ~470 MB, ~5x faster on CPU
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ---- Pipeline ---------------------------------------------------------------
CHUNKING_STRATEGY=sentence
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_TOP_K=5
RAG_MIN_CONFIDENCE=0.30

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragbuilder
POSTGRES_USER=ragbuilder
POSTGRES_PASSWORD=ragbuilder

# ---- Qdrant / MLflow --------------------------------------------------------
QDRANT_URL=http://qdrant:6333
MLFLOW_TRACKING_URI=http://mlflow:5000
