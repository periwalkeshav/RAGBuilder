# syntax=docker/dockerfile:1
# Streamlit chat UI. Deliberately separate from the API image: it needs neither
# torch nor the embedding model, so it stays around 400 MB and deploys to
# Streamlit Community Cloud unchanged.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-ui.txt /app/requirements-ui.txt
RUN pip install --no-cache-dir -r /app/requirements-ui.txt

COPY ui/ /app/ui/
COPY .streamlit/ /app/.streamlit/

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD curl -fsS http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "ui/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
